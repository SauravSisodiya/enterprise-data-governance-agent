# Copy this file to .env for local development. python-dotenv loads it
# automatically (see governance/narrative/client.py) - you do not need to
# `source` or `export` anything yourself once .env exists.
#
# .env itself is git-ignored (see .gitignore) - never commit real keys.
#
# NOT needed for Streamlit Community Cloud deployment - use
# .streamlit/secrets.toml.example instead for that (Cloud does not read .env
# files, only its own Secrets panel / .streamlit/secrets.toml).

# Groq - fast hosted inference of open models (e.g. Llama). Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=

# xAI's Grok - a different provider from Groq above, don't mix them up.
# Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the default model for either backend.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROK_MODEL=grok-4.5
