# Copy this file to ".env" and paste your key after the = sign.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it - this repository is public, and leaked
# keys on public GitHub are found by scrapers within minutes.

GROQ_API_KEY=

# Optional. Leave blank to use the default. If the default id has been retired,
# `python -m governance.narrative.check` prints the ids your account can reach.
GROQ_MODEL=
